digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.5",ranksep="1",splines=polyline];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
edge [color="#475569",fontname="DejaVu Sans",fontsize=10,arrowsize=0.8];
Persona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>Persona</B></TD></TR><TR><TD ALIGN="LEFT">«abstract»</TD></TR><TR><TD ALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT">+ getNombre() : String</TD></TR><TR><TD ALIGN="LEFT">+ setNombre(String) : void</TD></TR><TR><TD ALIGN="LEFT">+ tipo() : String</TD></TR></TABLE>>];
Cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT">+ Cliente(String)</TD></TR><TR><TD ALIGN="LEFT">+ tipo() : String</TD></TR></TABLE>>];
Mecanico [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>Mecanico</B></TD></TR><TR><TD ALIGN="LEFT">+ Mecanico(String)</TD></TR><TR><TD ALIGN="LEFT">+ tipo() : String</TD></TR></TABLE>>];
ResumenPersonas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>ResumenPersonas</B></TD></TR><TR><TD ALIGN="LEFT">- personas : List&lt;Persona&gt;</TD></TR><TR><TD ALIGN="LEFT">+ agregar(Persona) : void</TD></TR><TR><TD ALIGN="LEFT">+ obtenerResumen() : List&lt;String&gt;</TD></TR></TABLE>>];
OrdenTrabajo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>OrdenTrabajo</B></TD></TR><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- estado : String</TD></TR><TR><TD ALIGN="LEFT">- servicios : List&lt;DetalleServicio&gt;</TD></TR><TR><TD ALIGN="LEFT">- repuestos : List&lt;DetalleRepuesto&gt;</TD></TR><TR><TD ALIGN="LEFT">+ agregarServicio(...) : void</TD></TR><TR><TD ALIGN="LEFT">+ agregarRepuesto(...) : void</TD></TR><TR><TD ALIGN="LEFT">+ tieneServicios() : boolean</TD></TR><TR><TD ALIGN="LEFT">+ calcularTotal() : BigDecimal</TD></TR></TABLE>>];
DetalleServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>DetalleServicio</B></TD></TR><TR><TD ALIGN="LEFT">- descripcion : String</TD></TR><TR><TD ALIGN="LEFT">- costo : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+ getCosto() : BigDecimal</TD></TR></TABLE>>];
DetalleRepuesto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>DetalleRepuesto</B></TD></TR><TR><TD ALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT">- cantidad : int</TD></TR><TR><TD ALIGN="LEFT">- precio : BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+ getSubtotal() : BigDecimal</TD></TR></TABLE>>];
OrdenService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>OrdenService</B></TD></TR><TR><TD ALIGN="LEFT">+ crear(...) : void</TD></TR><TR><TD ALIGN="LEFT">+ iniciar(int) : void</TD></TR><TR><TD ALIGN="LEFT">+ servicio(...) : void</TD></TR><TR><TD ALIGN="LEFT">+ repuesto(...) : void</TD></TR><TR><TD ALIGN="LEFT">+ quitarRepuesto(...) : void</TD></TR><TR><TD ALIGN="LEFT">+ quitarServicio(...) : void</TD></TR><TR><TD ALIGN="LEFT">+ finalizarOrden(int) : void</TD></TR><TR><TD ALIGN="LEFT">+ cancelar(int) : void</TD></TR></TABLE>>];
Cliente -> Persona [label="hereda",style=solid,arrowhead=empty];
Mecanico -> Persona [label="hereda",style=solid,arrowhead=empty];
ResumenPersonas -> Persona [label="0..* agregación",style=solid,arrowhead=odiamond];
OrdenTrabajo -> DetalleServicio [label="0..* composición",style=solid,arrowhead=diamond];
OrdenTrabajo -> DetalleRepuesto [label="0..* composición",style=solid,arrowhead=diamond];
OrdenService -> OrdenTrabajo [label="utiliza",style=dashed,arrowhead=vee];
}