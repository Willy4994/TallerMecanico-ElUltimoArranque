digraph MVC {rankdir=LR;node [shape=box,style=rounded,fontname="Helvetica"];Usuario -> PanelControlador [label="GET/POST"];PanelControlador -> Thymeleaf [label="Model.addAttribute"];Thymeleaf -> Usuario [label="HTML"];PanelControlador -> OrdenService;PanelControlador -> RegistroDAO;OrdenService -> MySQL;RegistroDAO -> MySQL;Android -> InventarioApiControlador [label="GET"];InventarioApiControlador -> MySQL [label="JDBC"];InventarioApiControlador -> Android [label="JSON"];PanelControlador -> ControladoresPDF;ControladoresPDF -> MySQL;}