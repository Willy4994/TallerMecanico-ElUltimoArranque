digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.25",nodesep="0.38",ranksep="0.85",splines=polyline,outputorder=edgesfirst];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
edge [color="#64748b",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
CLIENTES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>CLIENTES</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">identificador : VARCHAR [UK]</TD></TR><TR><TD ALIGN="LEFT">nombre : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">telefono : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">correo : VARCHAR</TD></TR></TABLE>>];
VEHICULOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>VEHICULOS</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">cliente_id : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">placa : VARCHAR [UK]</TD></TR><TR><TD ALIGN="LEFT">marca : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">modelo : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">anio : INT</TD></TR></TABLE>>];
MECANICOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>MECANICOS</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">nombre : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">telefono : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">especialidad : VARCHAR</TD></TR></TABLE>>];
ORDENES_TRABAJO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>ORDENES_TRABAJO</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">vehiculo_id : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">mecanico_id : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">problema : TEXT</TD></TR><TR><TD ALIGN="LEFT">estado : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">fecha_creacion : TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">fecha_finalizacion : DATETIME</TD></TR><TR><TD ALIGN="LEFT">total : DECIMAL</TD></TR></TABLE>>];
SERVICIOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>SERVICIOS</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">descripcion : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">costo : DECIMAL</TD></TR></TABLE>>];
REPUESTOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>REPUESTOS</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">nombre : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">descripcion : VARCHAR</TD></TR><TR><TD ALIGN="LEFT">precio : DECIMAL</TD></TR><TR><TD ALIGN="LEFT">existencia : INT</TD></TR></TABLE>>];
ORDEN_SERVICIOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>ORDEN_SERVICIOS</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">orden_id : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">servicio_id : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">costo : DECIMAL</TD></TR></TABLE>>];
ORDEN_REPUESTOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#e8f0fa" ALIGN="CENTER"><B>ORDEN_REPUESTOS</B></TD></TR><TR><TD ALIGN="LEFT">id : INT [PK]</TD></TR><TR><TD ALIGN="LEFT">orden_id : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">repuesto_id : INT [FK]</TD></TR><TR><TD ALIGN="LEFT">cantidad : INT</TD></TR><TR><TD ALIGN="LEFT">precio : DECIMAL</TD></TR></TABLE>>];
CLIENTES -> VEHICULOS [label="1:N posee"];
VEHICULOS -> ORDENES_TRABAJO [label="1:N tiene"];
MECANICOS -> ORDENES_TRABAJO [label="1:N atiende"];
ORDENES_TRABAJO -> ORDEN_SERVICIOS [label="1:N incluye"];
SERVICIOS -> ORDEN_SERVICIOS [label="1:N corresponde"];
ORDENES_TRABAJO -> ORDEN_REPUESTOS [label="1:N utiliza"];
REPUESTOS -> ORDEN_REPUESTOS [label="1:N corresponde"];
}